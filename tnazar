#!/usr/bin/env python3
"""Run tnazar from a checkout without installing it."""
import os
import sys

# Before any import of the package, which needs 3.9: on older Python say so instead of a
# traceback. Keep this file parseable by any Python 3 (no f-strings or annotations).
if sys.version_info < (3, 9):
    sys.stderr.write(
        "tnazar needs Python 3.9+; this is %s at %s.\n"
        "Install Python 3.9+ and run tnazar with it, e.g. python3.11 ./tnazar doctor\n"
        % (".".join(str(n) for n in sys.version_info[:3]), sys.executable))
    sys.exit(2)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from teesri_nazar.cli import main  # noqa: E402

sys.exit(main())
