# Example plan: run it with  ./tnazar run examples/settings.plan
# Works on any Android device or emulator. Your own plans go in plans/ (git ignores it).
app com.android.settings
name settings-example

flow home
  launch --restart
  wait "Search Settings" --timeout 15
end

case TC-01 "Network & internet opens"
  expect "The Network & internet page shows Internet"
  expect "Back returns to the Settings list"
  run home
  say "Opening Network & internet"
  tap "Network & internet"
  check "Internet" --for E1
  key back
  check "Search Settings" --for E2

case TC-02 "Search finds Wi-Fi settings"
  expect "Searching wifi lists Wi-Fi"
  run home
  tap "Search Settings"
  retry 2
    type "wifi" --into id=open_search_view_edit_text --clear
    wait "~Wi-Fi" --timeout 5
  end
  check "~Wi-Fi" --for E1

case TC-03 "Back from search returns to Settings"
  if "Search Settings"
    say "Already on the main list"
  else
    key back
    key back
  end
  check "Search Settings"
